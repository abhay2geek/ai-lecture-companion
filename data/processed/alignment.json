[
    {
        "segment": {
            "start": 0.0,
            "end": 6.0,
            "text": "The Space Launch Systems Core Stage is the framework of the world's most powerful rocket,"
        },
        "frame": {
            "timestamp": 0,
            "image_path": "data/frames/frame_0000.jpg"
        },
        "distance_s": 3.0
    },
    {
        "segment": {
            "start": 6.0,
            "end": 11.0,
            "text": "but before it's assembled and integrated into SLS, the Core Stage's five sections"
        },
        "frame": {
            "timestamp": 10,
            "image_path": "data/frames/frame_0010.jpg"
        },
        "distance_s": 1.5
    },
    {
        "segment": {
            "start": 11.0,
            "end": 19.0,
            "text": "will need a combination of more than 750 sensors, 45 miles of cabling and 100,000 fasteners."
        },
        "frame": {
            "timestamp": 10,
            "image_path": "data/frames/frame_0010.jpg"
        },
        "distance_s": 5.0
    },
    {
        "segment": {
            "start": 19.0,
            "end": 23.0,
            "text": "All that work is being done as we speak. Let's take a closer look."
        },
        "frame": {
            "timestamp": 20,
            "image_path": "data/frames/frame_0020.jpg"
        },
        "distance_s": 1.0
    },
    {
        "segment": {
            "start": 23.0,
            "end": 29.0,
            "text": "At the base of the Core Stage sits the engine section, home to the four RS-25 engines,"
        },
        "frame": {
            "timestamp": 30,
            "image_path": "data/frames/frame_0030.jpg"
        },
        "distance_s": 4.0
    },
    {
        "segment": {
            "start": 29.0,
            "end": 34.0,
            "text": "the thrust structure they push against, as well as more than 18 miles of cables."
        },
        "frame": {
            "timestamp": 30,
            "image_path": "data/frames/frame_0030.jpg"
        },
        "distance_s": 1.5
    },
    {
        "segment": {
            "start": 34.0,
            "end": 39.0,
            "text": "Because of this section's complexity and the extreme temperatures and vibrations it will experience,"
        },
        "frame": {
            "timestamp": 40,
            "image_path": "data/frames/frame_0040.jpg"
        },
        "distance_s": 3.5
    },
    {
        "segment": {
            "start": 39.0,
            "end": 45.0,
            "text": "nearly 500 sensors are being installed in the engine section to monitor conditions."
        },
        "frame": {
            "timestamp": 40,
            "image_path": "data/frames/frame_0040.jpg"
        },
        "distance_s": 2.0
    },
    {
        "segment": {
            "start": 45.0,
            "end": 52.0,
            "text": "The Core Stage contains two separate fuel sources, the liquid hydrogen tank and the liquid oxygen tank."
        },
        "frame": {
            "timestamp": 50,
            "image_path": "data/frames/frame_0050.jpg"
        },
        "distance_s": 1.5
    },
    {
        "segment": {
            "start": 52.0,
            "end": 58.0,
            "text": "Together, they hold a combination of 733,000 gallons of propellant."
        },
        "frame": {
            "timestamp": 50,
            "image_path": "data/frames/frame_0050.jpg"
        },
        "distance_s": 5.0
    },
    {
        "segment": {
            "start": 59.0,
            "end": 65.0,
            "text": "This fuel is kept so cold that it will actually shrink the tanks up to 6 inches in length"
        },
        "frame": {
            "timestamp": 60,
            "image_path": "data/frames/frame_0060.jpg"
        },
        "distance_s": 2.0
    },
    {
        "segment": {
            "start": 65.0,
            "end": 70.0,
            "text": "and more than 1 inch in diameter before they expand again as the fuel empties."
        },
        "frame": {
            "timestamp": 70,
            "image_path": "data/frames/frame_0070.jpg"
        },
        "distance_s": 2.5
    },
    {
        "segment": {
            "start": 70.0,
            "end": 76.0,
            "text": "That means that anything attached to the tanks must be secured with a variety of flexible"
        },
        "frame": {
            "timestamp": 70,
            "image_path": "data/frames/frame_0070.jpg"
        },
        "distance_s": 3.0
    },
    {
        "segment": {
            "start": 76.0,
            "end": 80.0,
            "text": "or accordion-like or telescoping connectors."
        },
        "frame": {
            "timestamp": 80,
            "image_path": "data/frames/frame_0080.jpg"
        },
        "distance_s": 2.0
    },
    {
        "segment": {
            "start": 80.0,
            "end": 85.0,
            "text": "The intertank is designed to connect the two fuel tanks."
        },
        "frame": {
            "timestamp": 80,
            "image_path": "data/frames/frame_0080.jpg"
        },
        "distance_s": 2.5
    },
    {
        "segment": {
            "start": 85.0,
            "end": 89.0,
            "text": "It isn't being welded together like the rest of SLS."
        },
        "frame": {
            "timestamp": 90,
            "image_path": "data/frames/frame_0090.jpg"
        },
        "distance_s": 3.0
    },
    {
        "segment": {
            "start": 89.0,
            "end": 97.0,
            "text": "The intertank is being put together by 14,500 custom bolts, fasteners and fittings."
        },
        "frame": {
            "timestamp": 90,
            "image_path": "data/frames/frame_0090.jpg"
        },
        "distance_s": 3.0
    },
    {
        "segment": {
            "start": 97.0,
            "end": 101.0,
            "text": "The brain of SLS is in its forward skirt section."
        },
        "frame": {
            "timestamp": 100,
            "image_path": "data/frames/frame_0100.jpg"
        },
        "distance_s": 1.0
    },
    {
        "segment": {
            "start": 101.0,
            "end": 108.0,
            "text": "The 45 miles of cables controlling the SLS eventually lead to the forward skirt section,"
        },
        "frame": {
            "timestamp": 100,
            "image_path": "data/frames/frame_0100.jpg"
        },
        "distance_s": 4.5
    },
    {
        "segment": {
            "start": 108.0,
            "end": 114.0,
            "text": "where three flight computers monitor more than 1,100 sensors to ensure a successful flight."
        },
        "frame": {
            "timestamp": 110,
            "image_path": "data/frames/frame_0110.jpg"
        },
        "distance_s": 1.0
    },
    {
        "segment": {
            "start": 115.0,
            "end": 121.0,
            "text": "Power for the computers and other Core Stage electronics is provided by four lithium-ion batteries."
        },
        "frame": {
            "timestamp": 120,
            "image_path": "data/frames/frame_0120.jpg"
        },
        "distance_s": 2.0
    },
    {
        "segment": {
            "start": 121.0,
            "end": 130.0,
            "text": "Each is about the size of an average car battery and provides about 1.8 kilowatts of power for the rocket's 10-minute mission."
        },
        "frame": {
            "timestamp": 130,
            "image_path": "data/frames/frame_0130.jpg"
        },
        "distance_s": 4.5
    },
    {
        "segment": {
            "start": 132.0,
            "end": 140.0,
            "text": "NASA engineers are working hard as we speak to make sure that every part of the Core Stage is outfitted and tested."
        },
        "frame": {
            "timestamp": 140,
            "image_path": "data/frames/frame_0140.jpg"
        },
        "distance_s": 4.0
    },
    {
        "segment": {
            "start": 140.0,
            "end": 142.0,
            "text": "But that's just the beginning."
        },
        "frame": {
            "timestamp": 140,
            "image_path": "data/frames/frame_0140.jpg"
        },
        "distance_s": 1.0
    },
    {
        "segment": {
            "start": 142.0,
            "end": 147.0,
            "text": "Once the individual sections are complete, the whole thing needs to be assembled."
        },
        "frame": {
            "timestamp": 140,
            "image_path": "data/frames/frame_0140.jpg"
        },
        "distance_s": 4.5
    },
    {
        "segment": {
            "start": 147.0,
            "end": 149.0,
            "text": "But we'll save that for another time."
        },
        "frame": {
            "timestamp": 150,
            "image_path": "data/frames/frame_0150.jpg"
        },
        "distance_s": 2.0
    },
    {
        "segment": {
            "start": 149.0,
            "end": 151.0,
            "text": "Thanks for watching!"
        },
        "frame": {
            "timestamp": 150,
            "image_path": "data/frames/frame_0150.jpg"
        },
        "distance_s": 0.0
    }
]